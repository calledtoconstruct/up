#################################
#  picom configuration (v12+)   #
#  https://picom.app/           #
#  Sample aligned with yshui/picom
#################################

#################################
#             Shadows           #
#################################

shadow = true;
shadow-radius = 12;
shadow-opacity = 0.75;
shadow-offset-x = -12;
shadow-offset-y = -12;
shadow-color = "#000000";
# crop-shadow-to-monitor = false;

#################################
#           Fading              #
#################################

# Theme may override via theme.conf (fade user setting).
fading = true;
fade-in-step = 0.03;
fade-out-step = 0.03;
# fade-delta = 10;
# no-fading-openclose = false;
# no-fading-destroyed-argb = false;

#################################
#   Transparency / Opacity      #
#################################

frame-opacity = 0.9;
# Dim lives on the unfocused rule in rules.conf (not global inactive-dim).

#################################
#           Corners             #
#################################

corner-radius = 3;

#################################
#            Blur               #
#################################

# Structured blur block is the current standard (see man picom BLUR).
# dual_kawase requires an OpenGL backend (glx). Range for strength: 0-20.
# capability.conf / theme.conf may disable or replace this block.
blur: {
    method = "dual_kawase";
    strength = 4;
};
blur-background = true;
# blur-background-frame = false;
# blur-background-fixed = false;

#################################
#       General Settings        #
#################################

# Default backend; capability.conf (applied last among includes) overrides
# based on hardware detection (glx for full/lite, xrender for safe).
backend = "glx";

dithered-present = false;
vsync = true;
detect-rounded-corners = true;
detect-client-opacity = true;
# use-ewmh-active-win = false;
# Fullscreen games/video skip compositing; other windows keep fade/blur/dim.
unredir-if-possible = true;
# unredir-if-possible-delay = 0;
detect-transient = true;
# detect-client-leader = false;
use-damage = true;
# force-win-blend = false;
# no-ewmh-fullscreen = false;
# max-brightness = 1.0;
# transparent-clipping = false;
# log-level = "warn";
# log-file = "/path/to/your/log/file";
# write-pid-path = "/path/to/picom.pid";

#################################
#        Window Rules           #
#  v12+ rules replace inactive- #
#  dim, opacity-rule, wintypes. #
#################################

@include "rules.conf"

# Theme overrides (generated by switch-theme.sh — do not hand-edit)
# Provides shadow-color and fade / blur toggles from ~/.config/up/config.
@include "theme.conf"

# Hardware capability overrides (generated by apply-compositor-profile.sh).
# Applied last so weak machines can force xrender / disable blur safely.
@include "capability.conf"
