# XLibre i3 Default Config — i3-wm with gaps, Arc/Papirus theme, picom integration
# Stock file: up-update may replace this copy (with a backup).
# Keep personal lines in ~/.config/up/overrides/i3.conf and
# ~/.config/up/keybindings-overrides.toml — those are never overwritten.
#
# IMPORTANT: Keybindings are defined in configs/keybindings.toml
# Do not edit bindsym lines directly in this file.

# Font (matches our noto + dejavu fonts)
font pango:DejaVu Sans Mono 10

# Gaps & borders (modern floating feel)
gaps inner 12
gaps outer 6
smart_gaps on
for_window [class=".*"] border pixel 2

# Theme colors (auto-generated by switch-theme.sh - do not edit)
include ~/.config/i3/theme.conf

# Floating window rules
for_window [class="^localsend$"] floating enable, move position center, resize set 500 700
for_window [class="(?i)(c|q|g)alculat(e|or)"] floating enable, move position center, resize set 400 500
for_window [class="^system-monitor$"] floating enable, move position center, resize set 800 500
for_window [class="^system-information$"] floating enable, move position center, resize set 700 600
for_window [class="^audio-controls$"] floating enable, move position center, resize set 700 600
for_window [class="^bluetooth-controls$"] floating enable, move position center, resize set 700 600
for_window [class="^wifi-controls$"] floating enable, move position center, resize set 700 600
for_window [class="^docker$"] floating enable, move position center, resize set 700 500

# Load background (skipped while the session curtain is active)
exec --no-startup-id /usr/local/share/up/configs/scripts/load-background.sh

# Fade the curtain out once i3 has parsed keybindings
exec --no-startup-id /usr/local/share/up/configs/scripts/session-curtain.sh reveal

# Start xsettingsd for GTK theme live-reload support
exec --no-startup-id xsettingsd

# Desktop apply agent: serial queue for theme / font / compositor / polybar / picom
exec --no-startup-id /usr/local/share/up/configs/scripts/desktop-agent.sh

# Config watcher only enqueues sync requests to the agent
exec --no-startup-id /usr/local/share/up/configs/scripts/config-watcher.sh

# Start the bar once. exec_always would run launch.sh again on every i3
# reload (theme switch) and race a second polybar. Theme apply / the
# agent restart the bar when colors change; agent starts it if missing.
exec --no-startup-id /usr/local/share/up/configs/polybar/launch.sh

# Start notification daemon (dunst)
exec --no-startup-id dunst

# Show first-boot notification (if first boot)
exec --no-startup-id /usr/local/share/up/configs/scripts/first-boot-notification.sh

# Variables
set $term    alacritty
set $menu    rofi -show drun
set $browser firefox

# Workspace variables
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# ============================================================================
# KEYBINDINGS - Generated from configs/keybindings.toml
# Do not edit below this line manually.
# ============================================================================

# Include generated keybindings from keybindings.toml (includes mode blocks)
include ~/.config/i3/keybindings.conf

# ============================================================================
# END OF GENERATED KEYBINDINGS
# ============================================================================

# Bar configuration is generated by switch-theme.sh in ~/.config/i3/theme.conf

# User extra i3 lines — never overwritten by up-update. Seeded as a comment
# file on install. Glob is ignored if the directory is empty. Last include wins.
include ~/.config/up/overrides/*.conf
