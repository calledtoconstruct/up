%up ALL=(root) NOPASSWD: /usr/local/share/up/bin/up-set-greeter-background
%up ALL=(root) NOPASSWD: /usr/local/bin/up-set-greeter-background *
%up ALL=(root) NOPASSWD: /usr/local/share/up/bin/up-set-greeter-background *
