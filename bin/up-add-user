#!/bin/bash
# Add User Script for Up Linux
# Creates a new user account and adds them to the 'up' group

set -euo pipefail

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UP_ROOT="${UP_ROOT:-/usr/local/share/up}"

# Source logging functions
source "$UP_ROOT/configs/scripts/logging.sh" 2>/dev/null || true

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored output
print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

# Check if running as root
if [ "$EUID" -ne 0 ]; then
    print_error "This script must be run as root (use sudo)"
    exit 1
fi

# Function to validate username
validate_username() {
    local username="$1"
    
    # Check if username is empty
    if [ -z "$username" ]; then
        print_error "Username cannot be empty"
        return 1
    fi
    
    # Check if username contains only valid characters (alphanumeric, underscore, hyphen)
    if ! [[ "$username" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
        print_error "Username must start with a letter or underscore and contain only lowercase letters, numbers, underscores, and hyphens"
        return 1
    fi
    
    # Check if username is too long (max 32 characters)
    if [ ${#username} -gt 32 ]; then
        print_error "Username must be 32 characters or less"
        return 1
    fi
    
    # Check if user already exists
    if id "$username" &>/dev/null; then
        print_error "User '$username' already exists"
        return 1
    fi
    
    return 0
}

# Function to validate full name
validate_fullname() {
    local fullname="$1"
    
    # Check if fullname is empty
    if [ -z "$fullname" ]; then
        print_error "Full name cannot be empty"
        return 1
    fi
    
    return 0
}

# Function to set password
set_password() {
    local username="$1"
    local password="$2"
    
    if echo "$username:$password" | chpasswd 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

# Main function
main() {
    echo "========================================="
    echo "       Up Linux - Add User Account"
    echo "========================================="
    echo ""
    
    # Ensure 'up' group exists
    if ! getent group up &>/dev/null; then
        print_info "Creating 'up' group..."
        groupadd up
        print_success "Created 'up' group"
    fi
    
    # Get username
    while true; do
        read -p "Enter username: " username
        username=$(echo "$username" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
        
        if validate_username "$username"; then
            break
        fi
    done
    
    # Get full name
    while true; do
        read -p "Enter full name (for user account): " fullname
        
        if validate_fullname "$fullname"; then
            break
        fi
    done
    
    # Get password
    while true; do
        read -s -p "Enter password: " password
        echo ""
        
        if [ -z "$password" ]; then
            print_error "Password cannot be empty"
            continue
        fi
        
        read -s -p "Confirm password: " password_confirm
        echo ""
        
        if [ "$password" != "$password_confirm" ]; then
            print_error "Passwords do not match"
            continue
        fi
        
        break
    done
    
    # Ask about sudo access
    echo ""
    read -p "Grant sudo access (wheel group)? [Y/n]: " grant_sudo
    grant_sudo=${grant_sudo:-Y}
    
    # Build group list
    local groups="up,audio,video,storage"
    if [[ "$grant_sudo" =~ ^[Yy]$ ]]; then
        groups="wheel,$groups"
        print_info "User will have sudo access"
    else
        print_info "User will NOT have sudo access"
    fi
    
    echo ""
    print_info "Creating user account..."
    
    # Create user with home directory
    if useradd -m -G "$groups" -c "$fullname" "$username"; then
        print_success "Created user account: $username"
    else
        print_error "Failed to create user account"
        exit 1
    fi
    
    # Set password
    print_info "Setting password..."
    if set_password "$username" "$password"; then
        print_success "Password set successfully"
    else
        print_error "Failed to set password"
        print_warning "You can set it manually later with: sudo passwd $username"
    fi
    
    # Set default shell to zsh
    if chsh -s /usr/bin/zsh "$username" 2>/dev/null; then
        print_success "Set default shell to zsh"
    else
        print_warning "Could not set default shell to zsh"
    fi
    
    # Copy skeleton files for user environment
    local user_home="/home/$username"
    
    # Copy default configs from skeleton if they don't exist
    if [ -d "/etc/skel" ]; then
        for skel_file in /etc/skel/.*; do
            if [ -f "$skel_file" ] && [ ! -f "$user_home/$(basename "$skel_file")" ]; then
                cp "$skel_file" "$user_home/" 2>/dev/null || true
            fi
        done
    fi
    
    # Copy Up Linux configs if UP_ROOT is available
    if [ -d "$UP_ROOT/configs" ]; then
        print_info "Setting up user environment..."
        
        # Create config directory
        mkdir -p "$user_home/.config"
        if [ -x "$UP_ROOT/configs/scripts/seed-user-overrides.sh" ]; then
            "$UP_ROOT/configs/scripts/seed-user-overrides.sh" --home "$user_home" || true
        fi
        
        # Copy configs (use rsync if available, otherwise cp)
        if command -v rsync &>/dev/null; then
            rsync -a --ignore-existing "$UP_ROOT/configs/" "$user_home/.config/" 2>/dev/null || true
        else
            cp -rn "$UP_ROOT/configs/"* "$user_home/.config/" 2>/dev/null || true
        fi
        
        # Generate .zshrc if the script exists
        if [ -f "$UP_ROOT/configs/scripts/package-groups.sh" ]; then
            source "$UP_ROOT/configs/scripts/package-groups.sh"
            if declare -f generate_zshrc &>/dev/null; then
                generate_zshrc "$username" 2>/dev/null || true
            fi
        fi
        
        # Apply default theme files (live session refresh is per-user after login)
        if [ -f "$UP_ROOT/configs/scripts/switch-theme.sh" ]; then
            HOME="$user_home" UP_DESKTOP_INLINE=1 \
              "$UP_ROOT/configs/scripts/switch-theme.sh" --theme aetherweft \
                --home "$user_home" --no-reload 2>/dev/null || true
        fi
        
        print_success "User environment configured"
    fi
    
    # Fix ownership of home directory
    chown -R "$username:$username" "$user_home"
    
    # Create .xprofile with environment exports for X11 sessions
    print_info "Creating .xprofile..."
    cat > "$user_home/.xprofile" << 'EOF'
#!/bin/sh
# Up Linux X11 Profile
# Sourced by LightDM Xsession wrapper before starting the session

# X11 Display Settings
export DISPLAY="${DISPLAY:-:0}"

# XDG Session Variables
export XDG_SESSION_TYPE="x11"
export XDG_CURRENT_DESKTOP="i3"
export XDG_SESSION_DESKTOP="i3-up"

# Ensure XAUTHORITY is set
if [ -z "$XAUTHORITY" ]; then
    export XAUTHORITY="$HOME/.Xauthority"
fi

# Add Up tools to PATH
if [ -d "/usr/local/share/up/bin" ]; then
    export PATH="/usr/local/share/up/bin:$PATH"
fi

# Up Root
export UP_ROOT="/usr/local/share/up"

# Source system profile for any additional environment setup
[ -f /etc/profile ] && . /etc/profile

# Source user profile if it exists
[ -f "$HOME/.profile" ] && . "$HOME/.profile"
EOF
    chmod 644 "$user_home/.xprofile"
    chown "$username:$username" "$user_home/.xprofile"
    
    # Create .xsession that calls start-session.sh (DRY - single source of truth)
    print_info "Creating .xsession..."
    cat > "$user_home/.xsession" << 'EOF'
#!/bin/sh
# Up Linux X11 Session
# Executed by LightDM Xsession wrapper after sourcing .xprofile
# Delegates to start-session.sh for actual session startup

exec /usr/local/share/up/configs/scripts/start-session.sh
EOF
    chmod 755 "$user_home/.xsession"
    chown "$username:$username" "$user_home/.xsession"
    
    echo ""
    echo "========================================="
    print_success "User account created successfully!"
    echo "========================================="
    echo ""
    echo "  Username: $username"
    echo "  Full Name: $fullname"
    echo "  Home Directory: $user_home"
    if [[ "$grant_sudo" =~ ^[Yy]$ ]]; then
        echo "  Groups: wheel, up, audio, video, storage"
        echo ""
        echo "  The user can now:"
        echo "  - Log in to the system"
        echo "  - Use sudo (via wheel group)"
        echo "  - Modify system settings (via up group)"
        echo "  - Change themes without sudo"
    else
        echo "  Groups: up, audio, video, storage"
        echo ""
        echo "  The user can now:"
        echo "  - Log in to the system"
        echo "  - Modify system settings (via up group)"
        echo "  - Change themes without sudo"
        echo ""
        echo "  Note: User does NOT have sudo access"
    fi
    echo ""
}

# Run main function
main "$@"