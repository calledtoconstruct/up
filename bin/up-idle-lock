#!/bin/bash
# Idle Lock Toggle - Enable/disable automatic screen locking on idle
# Modifies xautolock configuration

set -euo pipefail

# Configuration files
XINITRC="${HOME}/.xinitrc"
XSESSION="${HOME}/.xsession"
AUTOSTART="${HOME}/.config/autostart/xautolock.desktop"

# Check if xautolock is available
if ! command -v xautolock >/dev/null 2>&1; then
    echo "Error: xautolock not available"
    exit 1
fi

# Safe notification function
notify() {
    local title="$1"
    local message="$2"
    local urgency="${3:-normal}"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$message" -u "$urgency" 2>/dev/null || echo "$title: $message"
    else
        echo "$title: $message"
    fi
}

# Check if idle lock is active
is_idle_lock_active() {
    pgrep -f "xautolock" >/dev/null 2>&1
}

# Start idle lock
start_idle_lock() {
    if is_idle_lock_active; then
        notify "Idle Lock" "Already active" "normal"
        return 0
    fi

    # Start xautolock (5 minutes idle, lock with i3lock)
    xautolock -time 5 -locker "i3lock -c 000000" -notify 30 -notifier "notify-send 'Screen will lock in 30 seconds'" &

    # Create autostart entry for persistence
    mkdir -p "${HOME}/.config/autostart"
    cat > "$AUTOSTART" << 'EOF'
[Desktop Entry]
Type=Application
Name=Idle Lock
Exec=xautolock -time 5 -locker "i3lock -c 000000" -notify 30 -notifier "notify-send 'Screen will lock in 30 seconds'"
StartupNotify=false
Terminal=false
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
EOF

    notify "Idle Lock" "Enabled - Screen will lock after 5 minutes idle" "normal"
}

# Stop idle lock
stop_idle_lock() {
    if ! is_idle_lock_active; then
        notify "Idle Lock" "Already disabled" "normal"
        return 0
    fi

    # Kill xautolock processes
    pkill -f "xautolock" || true

    # Remove autostart entry
    rm -f "$AUTOSTART"

    notify "Idle Lock" "Disabled - Screen will not auto-lock" "normal"
}

# Toggle idle lock
toggle_idle_lock() {
    if is_idle_lock_active; then
        stop_idle_lock
    else
        start_idle_lock
    fi
}

# Show status menu
show_status_menu() {
    local status="Disabled"
    if is_idle_lock_active; then
        status="Enabled"
    fi

    local options="🔒  Toggle Idle Lock (Currently: $status)\n✅  Enable Idle Lock\n❌  Disable Idle Lock"

    local choice=$(echo -e "$options" | rofi -dmenu -i -p "Idle Lock" -lines 3 -width 350 -kb-cancel Escape)

    case "$choice" in
        *Toggle*) toggle_idle_lock ;;
        *Enable*) start_idle_lock ;;
        *Disable*) stop_idle_lock ;;
        *) exit 0 ;;
    esac
}

# Main logic
if [ $# -eq 0 ]; then
    # No arguments - show menu
    show_status_menu
else
    case "$1" in
        --toggle|--on|--off)
            toggle_idle_lock
            ;;
        --enable|--start)
            start_idle_lock
            ;;
        --disable|--stop)
            stop_idle_lock
            ;;
        --status)
            if is_idle_lock_active; then
                echo "enabled"
            else
                echo "disabled"
            fi
            ;;
        --help)
            echo "Usage: $0 [OPTION]"
            echo "Control automatic screen locking on idle"
            echo ""
            echo "Options:"
            echo "  --toggle, --on, --off    Toggle idle lock on/off"
            echo "  --enable, --start        Enable idle lock"
            echo "  --disable, --stop        Disable idle lock"
            echo "  --status                  Show current status"
            echo "  --help                    Show this help"
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
fi